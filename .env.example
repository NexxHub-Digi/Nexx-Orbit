# Nexx Orbit: NEVER commit actual credentials.
# API identity — issuer, audience, JWKS must belong to same trusted OIDC provider.
OIDC_ISSUER=https://identity.example.com/
OIDC_AUDIENCE=nexx-orbit-api
OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json

# Public web API uses only orbit_api; non-superuser, no BYPASSRLS.
DATABASE_URL=postgresql://orbit_api:replace-me@host.neon.tech/orbit?sslmode=require

# Separate background worker process (never browser and never web-API DATABASE_URL).
WORKER_DATABASE_URL=postgresql://orbit_worker:replace-me@host.neon.tech/orbit?sslmode=require
ORBIT_WORKER_TENANT_ID=00000000-0000-0000-0000-000000000001
ORBIT_WORKER_SUBJECT=worker:tenant-example

# CLI tenant-provisioning only; do not configure on Vercel or browser environments.
ADMIN_DATABASE_URL=postgresql://orbit_owner:replace-me@host.neon.tech/orbit?sslmode=require
