# Never commit real credentials. Protected APIs fail closed when missing.
# OIDC provider settings must all correspond to the same trusted issuer.
OIDC_ISSUER=https://identity.example.com/
OIDC_AUDIENCE=nexx-orbit-api
OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json

# MUST be a restricted, non-BYPASSRLS application role.
# Migration connections should use a DIFFERENT privileged role.
DATABASE_URL=postgresql://orbit_app:replace-me@host.neon.tech/neondb?sslmode=require
