# Public browser OAuth: Web application client registered with Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_APP_ORIGIN=http://localhost:3000
AUTH_SESSION_SECRET= # >=32 random UTF-8 bytes; generate securely; never commit values

# Optional Bearer token verification for external OIDC API clients.
OIDC_ISSUER=https://identity.example.com/
OIDC_AUDIENCE=nexx-orbit-api
OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json

# Each database connection MUST use the right role:
DATABASE_URL=postgresql://orbit_api:replace-me@host.neon.tech/orbit?sslmode=require
WORKER_DATABASE_URL=postgresql://orbit_worker:replace-me@host.neon.tech/orbit?sslmode=require
ORBIT_WORKER_SUBJECT=worker:orbit-dispatcher
ORBIT_WORKER_POLL_MS=3000

# CLI provisioning for legacy tenants only; never configure this in Vercel.
ADMIN_DATABASE_URL=postgresql://orbit_owner:replace-me@host.neon.tech/orbit?sslmode=require
